# Разные ключи для доступа к приложению и к ProxyAPI.
BRIEF_API_KEY=replace-with-random-application-key
PROXYAPI_API_KEY=replace-with-proxyapi-key
PROXYAPI_BASE_URL=https://api.proxyapi.ru/v1
PROXYAPI_MODEL=openai/gpt-6-luna
PROXYAPI_TIMEOUT_SECONDS=45
PROXYAPI_MAX_COMPLETION_TOKENS=2000
# При reasoning_effort=none модель допускает низкую температуру.
PROXYAPI_TEMPERATURE=0.2
MAX_INPUT_CHARS=10000
DAILY_LLM_CALL_LIMIT=100
HOST_PORT=8000
APP_ENVIRONMENT=local
